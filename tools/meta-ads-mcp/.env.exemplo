# Copie este arquivo para .env, na mesma pasta, e preencha voce mesmo.
# O .env esta no .gitignore e nunca deve ser commitado.
# Eu nao preencho token: credencial e sua, digitada por voce.

# Token do System User (developers.facebook.com -> Business Settings -> System Users).
# Permissoes minimas: ads_read. Acrescente ads_management SO se for liberar escrita.
META_ACCESS_TOKEN=

# Id da conta de anuncios, com o prefixo act_
META_AD_ACCOUNT_ID=act_

# App do Meta (so necessario se for gerar/renovar token por codigo)
META_APP_ID=
META_APP_SECRET=

# Versao da Graph API. Confira a atual em developers.facebook.com/docs/graph-api/changelog
# e suba aqui quando a sua for descontinuada.
META_API_VERSAO=v23.0

# Trava de seguranca. Vazio = somente leitura.
# Coloque 1 so quando quiser que o agente possa pausar campanha e mexer em orcamento.
META_PERMITIR_ESCRITA=

# Teto de seguranca para meta_mudar_orcamento, em reais por dia.
META_TETO_DIARIO_BRL=100
